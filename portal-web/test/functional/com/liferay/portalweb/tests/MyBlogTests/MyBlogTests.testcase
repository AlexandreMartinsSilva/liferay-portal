@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		HeadlessSite.addSite(siteName = "Test Site Name");

		task ("given the addition of a blog"){

		JSONLayout.addPublicLayout(
			groupName = "Test Site Name",
			layoutName = "Blogs Page");

		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Test Site Name",
			layoutName = "Blogs Page",
			widgetName = "Blogs");
			
	    JSONBlog.addEntry(
			groupName = "Test Site Name",
			entryContent = "My Content",
			entryTitle = "My Blogs");
		}
	}

	tearDown {
		PortalInstances.tearDownCP();

		JSONGroup.deleteGroupByName(groupName = "Test Site Name");
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("When the user adds a Blog Entry") {
			BlogsNavigator.openToAddEntry(
				layoutName = "Blogs Page",
				siteURLKey = "test-site-name");

			BlogsEntry.addEntryContent(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title 1");

			Button.clickPublish();
		}

		task ("Then the Blog Entry should display on the page") {
			Navigator.gotoSitePage(
				pageName = "Blogs Page",
				siteName = "Test Site Name");

			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title 1");

		}
	}

	@description = "Can delete Blog"
	@priority = 5
	test CanDeletBlog {
		task ("And a 2 Blog Entries exists") {

		Navigator.gotoSitePage(
			pageName = "Blogs Page",
			siteName = "Test Site Name");

		BlogsNavigator.openToAddEntry(
			layoutName = "Blogs Page",
			siteURLKey = "test-site-name");

		BlogsEntry.addEntryContent(
			entryContent = "Blogs Entry Content",
			entryTitle = "Blogs Entry Title");

		Button.clickPublish();

		Navigator.gotoSitePage(
			pageName = "Blogs Page",
			siteName = "Test Site Name");

		
			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");

			BlogsEntry.viewEntryPG(
				entryContent = "My Content",
				entryTitle = "My Blogs");
		}

		task ("Then Blog Entry 1 should not exist") {
			BlogsNavigator.openToAddEntry(
				layoutName = "Blogs Page",
				siteURLKey = "test-site-name");

			Navigator.gotoSitePage(
				pageName = "Blogs Page",
				siteName = "Test Site Name");

			BlogsEntry.moveToRecycleBinPG(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");
		}

		task ("And Blog Entry 2 should exist") {
			Navigator.gotoSitePage(
				pageName = "Blogs Page",
				siteName = "Test Site Name");

			BlogsEntry.viewEntryPG(
				entryContent = "My Content",
				entryTitle = "My Blogs");
		}
	}

	@description = "Can Edit Blog"
	@priority = 5
	test CanEditBlog {
		task ("And a Blog Entry exists") {
			BlogsNavigator.openToAddEntry(
				layoutName = "Blogs Page",
				siteURLKey = "test-site-name");

			Navigator.gotoSitePage(
				pageName = "Blogs Page",
				siteName = "Test Site Name");
		}

		task ("When the User edits the blog Entry") {
			BlogsNavigator.gotoEditPG(entryTitle = "My Blogs");

			BlogsEntry.editTitle(
				entryTitle = "My Blogs",
				entryTitleEdit = "Blogs Entry Title 1");

			BlogsEntry.editContent(
				entryContent = "My Content",
				entryContentEdit = "Blogs Entry Content 1");

			Button.clickPublish();
		}

		task ("Then the Blog Entry should be edited") {
			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content 1",
				entryTitle = "Blogs Entry Title 1");
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("And a 2 Blog Entries exists") {

		BlogsNavigator.openToAddEntry(
			layoutName = "Blogs Page",
			siteURLKey = "test-site-name");

		 JSONBlog.addEntry(
			groupName = "Test Site Name",
			entryContent = "Blogs Entry Content",
			entryTitle = "Blogs Entry Title");

		Navigator.gotoSitePage(
			pageName = "Blogs Page",
			siteName = "Test Site Name");

		
			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");

			BlogsEntry.viewEntryPG(
				entryContent = "My Content",
				entryTitle = "My Blogs");
		}

		task ("When the User searches for Blog Entry 1") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "test-site-name");

			BlogsEntry.searchCP(
				entryContent = "My Content",
				entrySearchTerm = "My Content",
				entryTitle = "My Blogs");
		}

		task ("Then Blog Entry 1 should display") {
			Navigator.gotoSitePage(
				pageName = "Blogs Page",
				siteName = "Test Site Name");
		}
	}

}